generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User { 
  id        String   @id @default(uuid()) 
  email     String   @unique
  name      String?
  password  String   // Corrigido para minúsculo (padrão recomendado)
  createdAt DateTime @default(now()) @map("created_at") // Corrigido de createdAd para createdAt
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
